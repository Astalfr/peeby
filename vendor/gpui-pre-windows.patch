+/// PEEBY PATCH: the text a drag carries (`CF_UNICODETEXT`), trimmed; `None` without text.
+fn dropped_text(data: &IDataObject) -> Option<String> {
+    use windows::Win32::System::Memory::{GlobalLock, GlobalSize, GlobalUnlock};
+    let config = FORMATETC {
+        cfFormat: CF_UNICODETEXT.0,
+        ptd: std::ptr::null_mut() as _,
+        dwAspect: DVASPECT_CONTENT.0,
+        lindex: -1,
+        tymed: TYMED_HGLOBAL.0 as _,
+    };
+    // SAFETY: `data` is the drag's live object; the memory is read only between its lock and
+    // unlock, within the size Windows gives, and the medium is released once.
+    unsafe {
+        if data.QueryGetData(&config as _) != S_OK {
+            return None;
+        }
+        let mut medium = data.GetData(&config as _).log_err()?;
+        let global = medium.u.hGlobal;
+        let mut text = None;
+        if !global.is_invalid() {
+            let units = GlobalSize(global) / 2;
+            let ptr = GlobalLock(global) as *const u16;
+            if !ptr.is_null() {
+                let wide = std::slice::from_raw_parts(ptr, units);
+                let end = wide.iter().position(|&c| c == 0).unwrap_or(wide.len());
+                text = String::from_utf16(&wide[..end]).ok();
+                GlobalUnlock(global).ok();
+            }
+        }
+        ReleaseStgMedium(&mut medium);
+        text.map(|t| t.trim().to_owned()).filter(|t| !t.is_empty())
+    }
+}
