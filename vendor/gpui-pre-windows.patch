+// PEEBY PATCH (external textures): a polychrome image whose bytes start with this magic,
+// followed by a little-endian u64 legacy DXGI shared handle, is not uploaded. The shared
+// D3D11 texture is opened on the renderer's device and drawn directly (zero copy).
+// See docs/player/video-surface.md in the Peeby repository.
+const EXTERNAL_TEXTURE_MAGIC: &[u8; 8] = b"GPUIEXT1";
+const EXTERNAL_TEXTURE_INDEX_BASE: u32 = 1 << 30;
+
+/// Shared handles the application registered. The magic in image bytes is only honored for
+/// these, so an arbitrary image (e.g. downloaded artwork) can never make GPUI open a handle.
+static REGISTERED_HANDLES: LazyLock<StdMutex<HashSet<u64>>> =
+    LazyLock::new(|| StdMutex::new(HashSet::new()));
+
+/// PEEBY PATCH: allows images carrying `handle` to be drawn as an external texture.
+pub fn register_external_texture(handle: u64) {
+    if let Ok(mut handles) = REGISTERED_HANDLES.lock() {
+        handles.insert(handle);
+    }
+}
+
+/// PEEBY PATCH: revokes a handle registered with [`register_external_texture`].
+pub fn unregister_external_texture(handle: u64) {
+    if let Ok(mut handles) = REGISTERED_HANDLES.lock() {
+        handles.remove(&handle);
+    }
+}
+
+fn is_registered(handle: u64) -> bool {
+    REGISTERED_HANDLES
+        .lock()
+        .map(|handles| handles.contains(&handle))
+        .unwrap_or(false)
+}
