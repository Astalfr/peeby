+/// PEEBY PATCH: the platform's cursor visibility flag, for [`hide_cursor_until_mouse_moves`].
+static CURSOR_VISIBLE: std::sync::OnceLock<Arc<AtomicBool>> = std::sync::OnceLock::new();
