+/// PEEBY PATCH: hides the mouse cursor until the mouse moves again, when it is over a window of
+/// the calling (UI) thread. GPUI only does this itself while typing; the mouse-move handler
+/// restores the cursor as usual.
+pub fn hide_cursor_until_mouse_moves() {
+    let Some(visible) = CURSOR_VISIBLE.get() else {
+        return;
+    };
+    let mut point = POINT::default();
+    let over_own_window = unsafe {
+        GetCursorPos(&mut point).is_ok()
+            && GetWindowThreadProcessId(WindowFromPoint(point), None) == GetCurrentThreadId()
+    };
+    if over_own_window && visible.swap(false, Ordering::Relaxed) {
+        unsafe { SetCursor(None) };
+    }
+}
